# Project: __CODENAME__HELLO
# Compiler: Default GCC compiler
# Compiler Type: MingW 3
# Makefile created by wxDev-C++ IDE 7.4.2.569 on 08.03.15 14:26

WXLIBNAME = wxmsw29u
CPP       = g++.exe
CC        = gcc.exe
WINDRES   = "windres.exe"
OBJ       = Objects/MingW/main.o Objects/MingW/hello-rly1_private.res
LINKOBJ   = "Objects/MingW/main.o" Objects/MingW/hello-rly1_private.res
LIBS      = -L"Z:/DEV/IDE/wxDev-Cpp/lib/wx/gcc_lib" -L"Z:/DEV/IDE/wxDev-Cpp/lib" -lopengl32 -lglu32 -lglaux -lgdi32 -mwindows  
INCS      = -I"Z:/DEV/IDE/wxDev-Cpp/include"
CXXINCS   = -I"Z:/DEV/IDE/wxDev-Cpp/" -I"Z:/DEV/IDE/wxDev-Cpp/" -I"Z:/DEV/IDE/wxDev-Cpp/include/common"
RCINCS    = --include-dir "Z:/DEV/IDE/WXDEV-~1/include/common"
BIN       = Output/MingW/hello-rly1.exe
DEFINES   = 
CXXFLAGS  = $(CXXINCS) $(DEFINES)   -ansi -w
CFLAGS    = $(INCS) $(DEFINES)   -ansi -w
GPROF     = gprof.exe
ifeq ($(OS),Windows_NT)
   RM = del /Q
   FixPath = $(subst /,\,$1)
else
   RM = rm -f
   FixPath = $1
endif
LINK      = g++.exe

.PHONY: all all-before all-after clean clean-custom
all: all-before $(BIN) all-after

clean: clean-custom
	$(RM) $(call FixPath,$(LINKOBJ)) "$(call FixPath,$(BIN))"

$(BIN): $(OBJ)
	$(LINK) $(LINKOBJ) -o "$(BIN)" $(LIBS) 

Objects/MingW/main.o: $(GLOBALDEPS) main.cpp
	$(CPP) -c main.cpp -o Objects/MingW/main.o $(CXXFLAGS)

Objects/MingW/hello-rly1_private.res: Objects/MingW/hello-rly1_private.rc 
	$(WINDRES) --input-format=rc -o Objects/MingW/hello-rly1_private.res $(RCINCS) Objects/MingW/HELLO-~1.RC -O coff
