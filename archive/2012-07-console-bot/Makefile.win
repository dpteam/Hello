CPP  = g++.exe
CC   = gcc.exe
WINDRES = windres.exe
RES  = 
OBJ  = main.o $(RES)
LINKOBJ  = main.o $(RES)
LIBS =  -L"lib" -L"H:/dxsdk/lib" -L"D:/Program Files/Microsoft Speech SDK 5.1/Lib/i386" -L"H:/SDL-1.2.15/lib" -L"H:/DOOM/!DartPower_Projects/SDL-1.2.15/lib"  
INCS =  -I"include"  -I"H:/dxsdk/include"  -I"D:/Program Files/Microsoft Speech SDK 5.1/Include"  -I"H:/SDL-1.2.15/include"  -I"H:/SDL-1.2.15/include/SDL"  -I"H:/DOOM/!DartPower_Projects/SDL-1.2.15/include" 
CXXINCS =  -I"lib/gcc/mingw32/3.4.2/include"  -I"include/c++/3.4.2/backward"  -I"include/c++/3.4.2/mingw32"  -I"include/c++/3.4.2"  -I"include"  -I"H:/dxsdk/lib"  -I"H:/dxsdk/include"  -I"H:/dxsdk/src"  -I"H:/DOOM/!DartPower_Projects/SDL-1.2.15/include" 
BIN  = Проект1.exe
CXXFLAGS = $(CXXINCS)   -traditional-cpp -w -fexpensive-optimizations -O3
CFLAGS = $(INCS) -lSDL   -traditional-cpp -w -fexpensive-optimizations -O3
RM = rm -f

.PHONY: all all-before all-after clean clean-custom

all: all-before Проект1.exe all-after


clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CC) $(LINKOBJ) -o "Проект1.exe" $(LIBS)

main.o: main.c
	$(CC) -c main.c -o main.o $(CFLAGS)
